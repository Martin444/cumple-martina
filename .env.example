# Firebase — todas las variables son públicas a propósito.
# La app es 100% cliente y NO tiene secrets: la seguridad está en firestore.rules.
# Para development local contra los emuladores, poné PUBLIC_USE_FIREBASE_EMULATORS=true.
#
# Traelas de Firebase Console → Project settings → Your apps → SDK setup.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Solo para dev local. En producción tiene que estar en false/absente.
PUBLIC_USE_FIREBASE_EMULATORS=false
